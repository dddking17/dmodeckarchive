# Supabase 프로젝트 설정 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 덱/디지몬 카탈로그를 추가·수정·삭제할 수 있는 유일한 관리자 계정의 UID
# Supabase 대시보드 → Authentication → Users 에서 본인 계정의 User UID를 복사
NEXT_PUBLIC_ADMIN_USER_ID=

# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local 은 .gitignore 에 포함되어 있어 깃허브에 올라가지 않습니다.
